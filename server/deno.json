{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-env --allow-run --env=.env src/main.ts",
    "dev:admin": "npx vite",
    "start": "deno run --allow-net --allow-read --allow-env --allow-run --env=.env src/main.ts",
    "build:admin": "npx vite build",
    "prod": "npx vite build && deno run --allow-net --allow-read --allow-env --allow-run --env=.env src/main.ts",
    "test": "deno test --allow-net --allow-read --allow-env --allow-run",
    "db:migrate": "npx node-pg-migrate up -m migrations",
    "db:migrate:down": "npx node-pg-migrate down -m migrations",
    "check": "deno check src/main.ts"
  },
  "imports": {
    "hono": "npm:hono@^4",
    "hono/cors": "npm:hono@^4/cors",
    "hono/cookie": "npm:hono@^4/cookie",
    "hono/secure-headers": "npm:hono@^4/secure-headers",
    "drizzle-orm": "npm:drizzle-orm@^0.38",
    "drizzle-orm/postgres-js": "npm:drizzle-orm@^0.38/postgres-js",
    "drizzle-orm/pg-core": "npm:drizzle-orm@^0.38/pg-core",
    "postgres": "npm:postgres@^3.4",
    "zod": "npm:zod@^3.24",
    "@simplewebauthn/server": "npm:@simplewebauthn/server@^13.1",
    "@std/crypto/timing-safe-equal": "jsr:@std/crypto@^1/timing-safe-equal",
    "@std/encoding/base64": "jsr:@std/encoding@^1/base64",
    "@std/path": "jsr:@std/path@^1",
    "@std/testing": "jsr:@std/testing@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "xss": "npm:xss@^1.0",
    "he": "npm:he@^1.2",
    "validator": "npm:validator@^13.15",
    "jsonwebtoken": "npm:jsonwebtoken@^9.0",
    "ms": "npm:ms@^2.1",
    "node-pg-migrate": "npm:node-pg-migrate@^8.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"]
  },
  "exclude": [
    "admin/",
    "node_modules/",
    "dist/",
    "public/"
  ],
  "nodeModulesDir": "auto",
  "npmRegistry": "https://registry.npmjs.org"
}
