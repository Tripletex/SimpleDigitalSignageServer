{
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys src/main.ts",
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys src/main.ts",
    "provision": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run provision/provision.ts"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"]
  }
}
